[user]
	email = 4448701+freechie@users.noreply.github.com
	name = John
	signingkey = /Users/what/.ssh/id_ed25519_github_signing.pub

[core]
	editor = nvim
	excludesFile = ~/.gitignore_global

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[fetch]
	prune = true

[diff]
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[alias]
	hdiff = -c core.pager=\"hunk pager\" diff
	hshow = -c core.pager=\"hunk pager\" show
	hunkdiff = !hunk diff
	hunkshow = !hunk show
[gpg]
	format = ssh
[commit]
	gpgsign = true
[tag]
	gpgSign = true
